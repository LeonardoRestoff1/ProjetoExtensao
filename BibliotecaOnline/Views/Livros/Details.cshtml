@model BibliotecaOnline.Models.Livro
@{
    ViewData["Title"] = Model.Titulo;
    ViewData["NavSection"] = "acervo";
    var isAdmin    = ViewBag.IsAdmin   as bool? ?? false;
    var loggedUser = ViewBag.LoggedUser as bool? ?? false;
    var disponivel = Model.Quantidade > 0;
}

<nav aria-label="Navegação" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item">
            <a asp-controller="Livros" asp-action="Index">
                <i class="bi bi-collection me-1"></i>Acervo
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Titulo</li>
    </ol>
</nav>

<div class="app-panel p-4">
    <div class="row g-4">
        <div class="col-md-3 col-sm-4 text-center">
            <div class="book-cover-placeholder mx-auto" style="height:200px;max-width:160px;font-size:3.5rem">
                <i class="bi bi-book"></i>
            </div>
        </div>
        <div class="col-md-9 col-sm-8">
            <h1 class="h3 mb-1">@Model.Titulo</h1>
            <p class="text-muted mb-2">
                <i class="bi bi-person-lines-fill me-1"></i>@Model.Autor
            </p>

            @if (!string.IsNullOrEmpty(Model.Categoria))
            {
                <span class="badge bg-light text-secondary border mb-3">
                    <i class="bi bi-tag me-1"></i>@Model.Categoria
                </span>
            }

            <div class="mb-3">
                @if (disponivel)
                {
                    <span class="status-badge status-ativo">
                        <i class="bi bi-check-circle-fill"></i>Disponível — @Model.Quantidade exemplar@(Model.Quantidade > 1 ? "es" : "")
                    </span>
                }
                else
                {
                    <span class="status-badge status-devolvido">
                        <i class="bi bi-x-circle"></i>Sem exemplares disponíveis
                    </span>
                }
            </div>

            @if (loggedUser && disponivel)
            {
                <form asp-action="Solicitar" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-arrow-left-right me-1"></i>Solicitar empréstimo
                    </button>
                </form>
            }
            else if (loggedUser && !disponivel)
            {
                <div class="alert alert-warning py-2 mb-3" role="alert">
                    <i class="bi bi-info-circle me-1"></i>
                    Não há exemplares disponíveis no momento. Tente novamente em breve.
                </div>
            }
            else if (string.IsNullOrEmpty(Context.Session.GetString(SessionAuth.AuthRoleKey)))
            {
                <div class="alert alert-info py-2 mb-3" role="alert">
                    <i class="bi bi-box-arrow-in-right me-1"></i>
                    <a asp-controller="Account" asp-action="Login" class="alert-link">Entre</a> ou
                    <a asp-controller="Account" asp-action="Register" class="alert-link">crie uma conta</a>
                    para solicitar este empréstimo.
                </div>
            }

            <div class="d-flex flex-wrap gap-2 mt-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Voltar ao acervo
                </a>
                @if (isAdmin)
                {
                    <a asp-action="Edit"   asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Excluir
                    </a>
                }
            </div>
        </div>
    </div>
</div>
