@model IEnumerable<BibliotecaOnline.Models.Emprestimo>

@{
    ViewData["Title"] = "Empréstimos do Usuário";
    var usuario = ViewBag.Usuario as BibliotecaOnline.Models.Usuario;
}

<h1>Empréstimos Ativos</h1>

@if (usuario != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@usuario.Nome</h5>
            <p class="card-text">
                <strong>E-mail:</strong> @usuario.Email<br />
                <strong>Telefone:</strong> @usuario.Telefone
            </p>
        </div>
    </div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Livro</th>
                <th>Data de Início</th>
                <th>Previsão de Devolução</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Livro?.Titulo</td>
                    <td>@item.DataInicio.ToString("dd/MM/yyyy")</td>
                    <td>@item.DataFim.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.DataDevolucaoReal == null)
                        {
                            @if (item.DataFim < DateTime.Now)
                            {
                                <span class="badge text-bg-light border text-dark">Atrasado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Em Empréstimo</span>
                            }
                        }
                        else
                        {
                            <span class="badge text-bg-light border text-dark">Devolvido</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        Este usuário não possui empréstimos ativos no momento.
    </div>
}

<div>
    <a asp-action="Index" class="btn btn-secondary">Voltar para a Lista</a>
</div>






