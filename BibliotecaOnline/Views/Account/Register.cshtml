@model BibliotecaOnline.Models.Usuario
@{
    ViewData["Title"] = "Cadastro";
    ViewData["NavSection"] = "login";
}

<div class="row justify-content-center py-lg-4">
    <div class="col-lg-7 col-md-9">
        <div class="app-panel p-4 p-md-5">

            <div class="mb-4">
                <h1 class="h4 mb-1">
                    <i class="bi bi-person-plus-fill text-primary me-2"></i>Novo usuário
                </h1>
                <p class="text-muted small mb-0">Preencha os dados para solicitar empréstimos no acervo</p>
            </div>

            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Nome" class="form-label fw-medium">
                            <i class="bi bi-person me-1 text-muted"></i>Nome completo
                        </label>
                        <input asp-for="Nome" class="form-control" placeholder="Seu nome completo" />
                        <span asp-validation-for="Nome" class="text-danger small" role="alert"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-medium">
                            <i class="bi bi-envelope me-1 text-muted"></i>E-mail
                        </label>
                        <input asp-for="Email" class="form-control" type="email"
                               placeholder="nome@exemplo.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small" role="alert"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefone" class="form-label fw-medium">
                            <i class="bi bi-telephone me-1 text-muted"></i>Telefone <span class="text-muted fw-normal">(opcional)</span>
                        </label>
                        <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000"
                               autocomplete="tel" inputmode="tel" />
                        <span asp-validation-for="Telefone" class="text-danger small" role="alert"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Senha" class="form-label fw-medium">
                            <i class="bi bi-lock me-1 text-muted"></i>Senha
                        </label>
                        <div class="input-group">
                            <input asp-for="Senha" class="form-control" id="senhaInput"
                                   type="password" placeholder="Mínimo 4 caracteres"
                                   autocomplete="new-password" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleSenha"
                                    aria-label="Mostrar ou ocultar senha">
                                <i class="bi bi-eye" id="senhaIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Senha" class="text-danger small" role="alert"></span>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <a asp-action="Login" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Já tenho conta
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Concluir cadastro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('toggleSenha').addEventListener('click', function () {
            var input = document.getElementById('senhaInput');
            var icon  = document.getElementById('senhaIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });
    </script>
}
