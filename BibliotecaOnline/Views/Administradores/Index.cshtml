@model IEnumerable<BibliotecaOnline.Models.Administrador>
@{
    ViewData["Title"] = "Administradores";
    var meuId = Context.Session.GetString(SessionAuth.AdminIdKey);
    var lista = Model.ToList();
    var total = lista.Count;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="h3 mb-1">Administradores</h1>
        <p class="text-muted small mb-0">Quem pode gerir o acervo, usuários e empréstimos</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Novo administrador</a>
</div>

<div class="app-panel p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in lista)
            {
                <tr>
                    <td>
                        @a.Nome
                        @if (a.Id == meuId)
                        {
                            <span class="badge text-bg-secondary ms-1">Você</span>
                        }
                    </td>
                    <td>@a.Email</td>
                    <td class="text-end">
                        @if (total > 1 && a.Id != meuId)
                        {
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Remover este administrador?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    O acesso de administrador usa o mesmo formulário de <strong>Entrar</strong> do site; informe o e-mail e a senha cadastrados aqui.
</p>
